# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# The CLI reads .env from the working directory; exported variables take precedence.

# Required for live discovery, live assisted relocation, and the live upstream agent demo.
# Default replay and all cassette/scripted demonstrations run without it.
# The model is chosen per run: `waypoint discover --model` (default claude-haiku-4-5).
ANTHROPIC_API_KEY=

# Fixture credentials for the local target app. NOT real credentials.
# Injected at type-time by SecretBroker; never enter a snapshot, prompt, or artifact.
MERIDIAN_USER=operator1
MERIDIAN_PASS=changeme

# Target app port for `make app` (the test harness picks a random free port).
PORT=8080
